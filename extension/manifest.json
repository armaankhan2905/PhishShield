{
  "manifest_version": 3,
  "name": "PhishShield",
  "version": "0.5.0",
  "description": "Flags phishing in Gmail and risky links on web pages, with the reasons. Uses your local PhishShield server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PhishShield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "shared/verdict.js",
        "content/ui.js",
        "content/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "shared/verdict.js",
        "content/ui.js",
        "content/links.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": [
        "content/app-bridge.js"
      ],
      "run_at": "document_end"
    }
  ]
}
